{% extends 'base.twig' %}

{% block navbar %}{% endblock %}
{% block footer %}{% endblock %}

{% block body_content %}
<div class="login-root">
  <div class="login-glow-a"></div>
  <div class="login-glow-b"></div>
  <div class="login-grid-overlay"></div>

  <div class="login-card">
    <div class="login-lockup">
      <div class="login-mark">
        <svg width="34" height="34" viewBox="0 0 34 34" fill="none">
          <defs>
            <linearGradient id="lg1" x1="0" y1="0" x2="34" y2="34">
              <stop offset="0%" stop-color="var(--accent)"></stop>
              <stop offset="100%" stop-color="var(--accent-soft)"></stop>
            </linearGradient>
          </defs>
          <rect x="1" y="1" width="32" height="32" rx="9" fill="#12121a" stroke="rgba(255,255,255,0.08)"></rect>
          <path d="M22.5 11.5C20.9 10 18.9 9.2 16.8 9.2C12.3 9.2 8.7 12.8 8.7 17.2C8.7 21.6 12.3 25.1 16.8 25.1C19 25.1 21 24.3 22.5 22.7" stroke="url(#lg1)" stroke-width="2.6" stroke-linecap="round" fill="none"></path>
          <circle cx="24.2" cy="17.2" r="2.1" fill="url(#lg1)"></circle>
        </svg>
      </div>
      <div class="login-wordmark">
        <div class="name">CyKrome</div>
        <div class="sub">Workspaces</div>
      </div>
      <span class="login-badge">Domain Admin</span>
      {% if available_languages|length > 1 %}
      <div class="ms-2 dropdown">
        <button type="button" class="btn p-0 border-0 bg-transparent dropdown-toggle text-secondary" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="font-size: 11.5px; opacity: 0.8;">
          <span class="flag-icon flag-icon-{{ mailcow_locale[-2:] }}"></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end login" style="background: #14151c; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px;">
          {% for key, val in available_languages %}
            <li>
              <a class="dropdown-item {% if mailcow_locale == key %}active{% endif %}" href="?{{ query_string({'lang': key}) }}" style="font-size: 12px; color: #cfd0da;">
                <span class="flag-icon flag-icon-{{ key[-2:] }} me-2"></span>{{ val }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
    </div>

    <h1 class="login-heading">Domain Admin</h1>
    <p class="login-tagline">Sign in to manage mailbox accounts, quotas, and domain settings.</p>

    {% if ui_texts.ui_announcement_text and ui_texts.ui_announcement_active %}
    <div class="login-alert alert-info rot-enc ui-announcement-alert">{{ ui_texts.ui_announcement_text|rot13 }}</div>
    {% endif %}

    {% if login_delay %}
    <div class="login-alert alert-warning">{{ lang.login.delayed|format(login_delay) }}</div>
    {% endif %}

    <div id="fido2-alerts"></div>

    <form method="post" autofill="off">
      <div class="login-field">
        <label for="login_user">Username</label>
        <div class="login-input-wrap">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8b8d9a" stroke-width="1.8"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <input class="login-input" type="text" name="login_user" id="login_user" placeholder="admin@example.org" required autofocus autocomplete="username" autocorrect="off" autocapitalize="none">
        </div>
      </div>

      <div class="login-field">
        <label for="pass_user">Password</label>
        <div class="login-input-wrap">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8b8d9a" stroke-width="1.8"><rect x="4.5" y="10.5" width="15" height="9.5" rx="2"></rect><path d="M8 10.5V7.8a4 4 0 0 1 8 0v2.7"></path></svg>
          <input class="login-input" type="password" name="pass_user" id="pass_user" placeholder="••••••••••••" required autocomplete="current-password">
        </div>
      </div>

      <div class="login-row-between">
        <label class="login-remember" id="remember-label">
          <input type="checkbox" name="remember_device" id="remember_device" style="display: none;" checked>
          <div class="login-checkbox" id="remember-checkbox-ui">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#0a0a0f" stroke-width="3.4"><path d="m4 12 6 6L20 6"></path></svg>
          </div>
          <span>Remember this device</span>
        </label>
        <a class="login-forgot" href="/reset-password">Forgot password?</a>
      </div>

      <button type="submit" class="login-btn-primary">Sign in to Domain Portal</button>
    </form>

    <div class="login-divider-row"><div class="line"></div><span>OR</span><div class="line"></div></div>

    <a href="#" id="fido2-login" class="login-sso-btn">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#cfd0da" stroke-width="1.8"><rect x="5" y="11" width="14" height="10" rx="2"></rect><circle cx="12" cy="16" r="1.5"></circle><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
      {{ lang.login.fido2_webauthn|default('Sign in with Security Key') }}
    </a>

    <div class="login-role-links">
      <a href="/">User Login</a>
      <span>·</span>
      <a href="/admin">Admin Panel</a>
    </div>
  </div>

  <div class="login-theme-picker">
    <span class="label">Accent</span>
    <button type="button" class="login-swatch-btn active" data-accent-val="violet" style="background: #8b5cf6;" title="Violet">
      <div class="ring" style="box-shadow: 0 0 0 2px #8b5cf6;"></div>
    </button>
    <button type="button" class="login-swatch-btn" data-accent-val="cyan" style="background: #06b6d4;" title="Cyan">
      <div class="ring" style="box-shadow: 0 0 0 2px #06b6d4;"></div>
    </button>
    <button type="button" class="login-swatch-btn" data-accent-val="amber" style="background: #f59e0b;" title="Amber">
      <div class="ring" style="box-shadow: 0 0 0 2px #f59e0b;"></div>
    </button>
  </div>

  <div class="login-footer-note">CyKrome Workspaces · Domain Admin session · v2026.1</div>
</div>

<script>
(function() {
  var remCheck = document.getElementById('remember_device');
  var remBox = document.getElementById('remember-checkbox-ui');
  var remLabel = document.getElementById('remember-label');
  if (remCheck && remBox && remLabel) {
    remLabel.addEventListener('click', function(e) {
      e.preventDefault();
      remCheck.checked = !remCheck.checked;
      if (remCheck.checked) {
        remBox.classList.remove('unchecked');
      } else {
        remBox.classList.add('unchecked');
      }
    });
  }

  var ACCENTS = {
    violet: { hex: '#8b5cf6', soft: '#a78bfa', glow: 'rgba(139,92,246,0.35)', glowStrong: 'rgba(139,92,246,0.55)' },
    cyan:   { hex: '#06b6d4', soft: '#22d3ee', glow: 'rgba(34,211,238,0.32)',  glowStrong: 'rgba(34,211,238,0.5)' },
    amber:  { hex: '#f59e0b', soft: '#fbbf24', glow: 'rgba(245,158,11,0.32)',  glowStrong: 'rgba(245,158,11,0.5)' }
  };

  function setAccent(key) {
    var data = ACCENTS[key] || ACCENTS.violet;
    if (key === 'violet') {
      document.documentElement.removeAttribute('data-accent');
    } else {
      document.documentElement.setAttribute('data-accent', key);
    }
    document.documentElement.style.setProperty('--accent', data.hex);
    document.documentElement.style.setProperty('--accent-soft', data.soft);
    document.documentElement.style.setProperty('--accent-glow', data.glow);
    document.documentElement.style.setProperty('--accent-glow-strong', data.glowStrong);
    try { localStorage.setItem('mailcow_accent', key); } catch(e){}

    document.querySelectorAll('.login-swatch-btn').forEach(function(btn) {
      if (btn.getAttribute('data-accent-val') === key) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
  }

  var saved = 'violet';
  try { saved = localStorage.getItem('mailcow_accent') || 'violet'; } catch(e){}
  setAccent(saved);

  document.querySelectorAll('.login-swatch-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      setAccent(this.getAttribute('data-accent-val'));
    });
  });
})();
</script>
{% endblock %}
